---
import BookLayout from '../../layouts/BookLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBookById, getAllBooks } from '../../data/books';

export function getStaticPaths() {
  const books = getAllBooks();
  return books.map(book => ({
    params: { id: book.id }
  }));
}

const { id } = Astro.params;
const book = getBookById(id);

if (!book) {
  return Astro.redirect('/404');
}
---

<BookLayout title={`${book.titleArabic} - دروس الشيخ وليد البغدادي`}>
  <a href="/" class="back-button" dir="rtl">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    <span>العودة للكتب</span>
  </a>

  <Breadcrumb bookTitle={book.titleArabic} />

  <article class="book-detail" dir="rtl">
    <header class="book-header animated-entry">
      <div class="book-icon-large">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h1 class="book-title">{book.titleArabic}</h1>
      <p class="book-description">{book.description}</p>
      <div class="book-meta">
        <span class="total-lessons">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          عدد الدروس: {book.lessons.length}
        </span>
      </div>
    </header>

    <div class="lessons-container">
      <h2 class="lessons-title fade-in">الدروس</h2>
      <div class="lessons-list">
        {book.lessons.map((lesson, index) => (
          <LessonCard lesson={lesson} index={index + 1} style={`animation-delay: ${index * 0.1}s`} />
        ))}
      </div>
    </div>
  </article>
</BookLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(60px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animated-entry {
    opacity: 0;
    transform: translateY(60px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .animated-entry.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .fade-in {
    opacity: 0;
    animation: fadeIn 0.5s ease-out forwards;
  }

  .top-nav {
    margin-bottom: 1.5rem;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: var(--white);
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 12px rgba(26, 95, 63, 0.2);
    transition: all 0.3s ease;
  }

  .back-button:hover {
    transform: translateX(-4px);
    box-shadow: 0 6px 20px rgba(26, 95, 63, 0.3);
  }

  .back-button svg {
    width: 20px;
    height: 20px;
    transform: rotate(180deg);
  }

  .book-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .book-header {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: var(--white);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    margin-bottom: 3rem;
    box-shadow: var(--shadow);
  }

  .book-icon-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    margin-bottom: 1.5rem;
    color: var(--accent-color);
  }

  .book-icon-large svg {
    width: 55px;
    height: 55px;
  }

  .book-title {
    font-family: 'Amiri', serif;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .book-description {
    font-size: 1.2rem;
    opacity: 0.95;
    margin-bottom: 1.5rem;
  }

  .book-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .total-lessons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .total-lessons svg {
    width: 24px;
    height: 24px;
  }

  .lessons-container {
    padding: 0 1rem;
  }

  .lessons-title {
    font-family: 'Amiri', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-color);
    text-align: center;
    margin-bottom: 2rem;
  }

  .lessons-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .back-button {
      padding: 0.65rem 1.25rem;
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
    }

    .back-button svg {
      width: 18px;
      height: 18px;
    }

    .book-detail {
      padding: 1.5rem 0.25rem;
    }

    .book-header {
      padding: 2rem 1.25rem;
      margin-bottom: 2rem;
      border-radius: 16px;
    }

    .book-icon-large {
      width: 80px;
      height: 80px;
    }

    .book-icon-large svg {
      width: 45px;
      height: 45px;
    }

    .book-title {
      font-size: 1.8rem;
    }

    .book-description {
      font-size: 1rem;
    }

    .lessons-container {
      padding: 0 0.25rem;
    }

    .lessons-title {
      font-size: 1.6rem;
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .book-detail {
      padding: 1rem 0;
    }

    .book-header {
      padding: 1.75rem 1rem;
      border-radius: 14px;
      margin-bottom: 1.75rem;
    }

    .book-icon-large {
      width: 70px;
      height: 70px;
      margin-bottom: 1.25rem;
    }

    .book-icon-large svg {
      width: 40px;
      height: 40px;
    }

    .book-title {
      font-size: 1.5rem;
    }

    .book-description {
      font-size: 0.95rem;
    }

    .total-lessons {
      font-size: 1rem;
    }

    .lessons-container {
      padding: 0;
    }

    .lessons-title {
      font-size: 1.4rem;
      margin-bottom: 1.25rem;
    }

    .back-button {
      width: 100%;
      justify-content: center;
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  // Observer les animations quand les éléments entrent dans le viewport
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        // Désactiver l'observation après l'animation
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observer le bouton de retour
  const backBtn = document.querySelector('.back-button');
  if (backBtn) {
    observer.observe(backBtn);
  }

  // Observer le breadcrumb
  const breadcrumb = document.querySelector('.breadcrumb');
  if (breadcrumb) {
    observer.observe(breadcrumb);
  }

  // Observer le header du livre
  const bookHeader = document.querySelector('.book-header');
  if (bookHeader) {
    observer.observe(bookHeader);
  }

  // Observer le titre des leçons
  const lessonsTitle = document.querySelector('.lessons-title');
  if (lessonsTitle) {
    observer.observe(lessonsTitle);
  }

  // Observer les cartes de leçons
  document.querySelectorAll('.animated-entry').forEach((el, index) => {
    // Ajouter un délai progressif basé sur l'index
    (el as HTMLElement).style.transitionDelay = `${index * 0.1}s`;
    observer.observe(el);
  });
</script>
