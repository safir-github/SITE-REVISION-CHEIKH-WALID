---
import MainLayout from '../../layouts/MainLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBookById, getAllBooks } from '../../data/books';

export function getStaticPaths() {
  const books = getAllBooks();
  return books.map(book => ({
    params: { id: book.id }
  }));
}

const { id } = Astro.params;
const book = getBookById(id);

if (!book) {
  return Astro.redirect('/404');
}
---

<MainLayout title={`${book.titleArabic} - دروس الشيخ وليد البغدادي`}>
  <Breadcrumb bookTitle={book.titleArabic} />

  <article class="book-detail" dir="rtl">
    <header class="book-header">
      <div class="book-icon-large">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
      <h1 class="book-title">{book.titleArabic}</h1>
      <p class="book-description">{book.description}</p>
      <div class="book-meta">
        <span class="total-lessons">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          عدد الدروس: {book.lessons.length}
        </span>
      </div>
    </header>

    <div class="lessons-container">
      <h2 class="lessons-title">الدروس</h2>
      <div class="lessons-list">
        {book.lessons.map((lesson, index) => (
          <LessonCard lesson={lesson} index={index + 1} />
        ))}
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .book-detail {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .book-header {
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: var(--white);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    margin-bottom: 3rem;
    box-shadow: var(--shadow);
  }

  .book-icon-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    margin-bottom: 1.5rem;
    color: var(--accent-color);
  }

  .book-icon-large svg {
    width: 55px;
    height: 55px;
  }

  .book-title {
    font-family: 'Amiri', serif;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .book-description {
    font-size: 1.2rem;
    opacity: 0.95;
    margin-bottom: 1.5rem;
  }

  .book-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .total-lessons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .total-lessons svg {
    width: 24px;
    height: 24px;
  }

  .lessons-container {
    padding: 0 1rem;
  }

  .lessons-title {
    font-family: 'Amiri', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-color);
    text-align: center;
    margin-bottom: 2rem;
  }

  .lessons-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .book-detail {
      padding: 1rem 0;
    }

    .book-header {
      padding: 2rem 1.5rem;
    }

    .book-icon-large {
      width: 80px;
      height: 80px;
    }

    .book-icon-large svg {
      width: 45px;
      height: 45px;
    }

    .book-title {
      font-size: 1.8rem;
    }

    .book-description {
      font-size: 1rem;
    }

    .lessons-title {
      font-size: 1.6rem;
    }
  }
</style>
