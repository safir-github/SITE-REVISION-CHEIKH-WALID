---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "دروس الشيخ وليد البغدادي",
  description = "دروس في العقيدة من شرح الشيخ وليد البغدادي"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <div class="container">
    <main class="home-main">
      <slot />
    </main>
  </div>

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-color: #1a5f3f;
      --secondary-color: #0d3d2a;
      --accent-color: #d4af37;
      --text-color: #2c2c2c;
      --light-bg: #f8f6f3;
      --white: #ffffff;
      --border-color: #ddd9d3;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 4px 20px rgba(26, 95, 63, 0.12);
      --reading-bg: #fafafa;
    }

    body {
      font-family: 'Tajawal', sans-serif;
      background: linear-gradient(to bottom, #f5f3f0 0%, #f8f6f3 100%);
      color: var(--text-color);
      line-height: 1.9;
      min-height: 100vh;
      font-size: 16px;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: "kern" 1, "liga" 1;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .home-main {
      min-height: 100vh;
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 0;
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 16px;
      }

      .home-main {
        max-width: 100%;
        padding: 2rem 0;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0 12px;
      }

      .home-main {
        max-width: 100%;
        padding: 1.5rem 0;
      }
    }
  </style>
</body>
</html>
