---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "دروس الشيخ وليد البغدادي",
  description = "دروس في العقيدة من شرح الشيخ وليد البغدادي"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <div class="container">
    <header>
      <h1 class="site-title">دروس الشيخ وليد البغدادي</h1>
      <p class="site-subtitle">علقمة بن فراس القرشي</p>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>جميع الحقوق محفوظة &copy; {new Date().getFullYear()}</p>
    </footer>
  </div>

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-color: #1a5f3f;
      --secondary-color: #0d3d2a;
      --accent-color: #d4af37;
      --text-color: #2c2c2c;
      --light-bg: #f8f6f3;
      --white: #ffffff;
      --border-color: #ddd9d3;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 4px 20px rgba(26, 95, 63, 0.12);
      --reading-bg: #fafafa;
    }

    body {
      font-family: 'Tajawal', sans-serif;
      background: linear-gradient(to bottom, #f5f3f0 0%, #f8f6f3 100%);
      color: var(--text-color);
      line-height: 1.9;
      min-height: 100vh;
      font-size: 16px;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: "kern" 1, "liga" 1;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: var(--white);
      padding: 2.5rem 0;
      text-align: center;
      border-radius: 0 0 24px 24px;
      box-shadow: var(--shadow);
      margin-bottom: 2.5rem;
    }

    .site-title {
      font-family: 'Amiri', serif;
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    .site-subtitle {
      font-size: 1.15rem;
      opacity: 0.95;
      font-weight: 300;
      letter-spacing: 0.01em;
    }

    main {
      min-height: 60vh;
      max-width: 900px;
      margin: 0 auto;
    }

    footer {
      background-color: var(--secondary-color);
      color: var(--white);
      text-align: center;
      padding: 1.5rem 0;
      margin-top: 3rem;
      border-radius: 20px 20px 0 0;
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 16px;
      }

      .site-title {
        font-size: 1.8rem;
      }

      .site-subtitle {
        font-size: 1rem;
      }

      main {
        max-width: 100%;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0 12px;
      }

      main {
        max-width: 100%;
      }

      header {
        padding: 2rem 0;
        border-radius: 0 0 20px 20px;
      }

      footer {
        border-radius: 16px 16px 0 0;
        padding: 1.25rem 0;
      }
    }
  </style>
</body>
</html>
